# Pinned inputs of the self-hosted basemap (read by infra/basemap/basemap.sh, run with `make basemap`).
#
# The basemap is a Protomaps PMTiles extract of OpenStreetMap (ODbL: "© OpenStreetMap contributors"). Extracts of
# the same build, bounding box and maximum zoom are byte-identical, so each area pins the SHA-256 of its extract.
# To move to a newer build: set BASEMAP_BUILD to a key from https://build-metadata.protomaps.dev/builds.json,
# run `make basemap`, and copy the SHA-256 it reports into the pins below (for both areas).

# Protomaps daily build (https://build.protomaps.com/<build>.pmtiles).
BASEMAP_BUILD=20261008
BASEMAP_MAXZOOM=15

# pmtiles CLI; keep the helper image equal to the Martin image in infra/compose/docker-compose.yml.
PMTILES_IMAGE=protomaps/go-pmtiles:v1.31.2
HELPER_IMAGE=ghcr.io/maplibre/martin:1.16.1

# Areas: `uganda` (local default) and `demo` (only the synthetic district; used by CI).
AREA_UGANDA_BBOX=29.57,-1.48,35.04,4.24
AREA_UGANDA_SHA256=f7831b215ff26fd5eae2d63d7fb3699cf776cad6a43dfe0d3a628d8b8f6a2d5c
AREA_DEMO_BBOX=32.56,0.33,32.62,0.37
AREA_DEMO_SHA256=441b7847f97e5d2bab5d5d2bb6fef8c1caa6c4b3d9d275d855ea265e3fd7218b

# Glyphs and sprites from protomaps/basemaps-assets at a fixed commit. The SHA-256 covers the content of the kept
# files (three Noto Sans font stacks, the font licence and the v4 sprites), not the tarball, whose compression
# GitHub does not guarantee to stay byte-identical.
ASSETS_COMMIT=028c18f713baecad011301ff7a69acc39bcc2ae7
ASSETS_SHA256=c41a03e8d6d59ddba6e632e0333c2b2ccd60234e7ef95d660cd83f224ae282c7
