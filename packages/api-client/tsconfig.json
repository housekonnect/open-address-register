{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // Generated code does not satisfy these two flags. Consumers import the compiled
    // declarations in dist/, so their own strict settings are unaffected.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "test"]
}
