# Copy to .env for `pnpm start`. On a phone, use your computer's LAN IP instead of localhost (and set the same
# host in the root .env as OIDC_PUBLIC_URL, PORTAL_PUBLIC_URL and TILES_PUBLIC_URL, so the backend accepts the token
# issuer and the map style points the phone at reachable hosts). On the Android emulator, keep localhost and forward
# the ports with `adb reverse` (see docs/testing/android-device.md).
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:9000/application/o/ugaddress-field/
# The one map style shared with the portal and the console.
EXPO_PUBLIC_MAP_STYLE_URL=http://localhost:3000/map/style.json
