# Local development environment for infra/compose.
#
# Run `make env` to create .env from this file. Every value set to __GENERATE__ is
# replaced with a fresh random secret. .env is gitignored and must never be committed.

COMPOSE_PROJECT_NAME=ugaddress

# --- Register database (PostGIS) -------------------------------------------
POSTGIS_PORT=5432
POSTGRES_PASSWORD=__GENERATE__
# Schema owner, used only by Flyway migrations.
REGISTER_OWNER_PASSWORD=__GENERATE__
# Runtime role used by the backend; row-level security applies to it.
REGISTER_APP_PASSWORD=__GENERATE__
# Read-only role used by Martin; it can only see the `tiles` schema.
MARTIN_READER_PASSWORD=__GENERATE__

# --- Authentik (OIDC) -------------------------------------------------------
AUTHENTIK_PORT=9000
AUTHENTIK_SECRET_KEY=__GENERATE__
AUTHENTIK_PG_PASS=__GENERATE__
# Initial admin user `akadmin`.
AUTHENTIK_BOOTSTRAP_PASSWORD=__GENERATE__
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@ugaddress.invalid
AUTHENTIK_BOOTSTRAP_TOKEN=__GENERATE__
# URL that browsers and devices use to reach Authentik. Use your LAN IP when testing the field app on a phone.
# Its port must equal AUTHENTIK_PORT.
OIDC_PUBLIC_URL=http://localhost:9000
CONSOLE_PUBLIC_URL=http://localhost:3001
PORTAL_PUBLIC_URL=http://localhost:3000
CONSOLE_CLIENT_SECRET=__GENERATE__
PORTAL_CLIENT_SECRET=__GENERATE__
# Client secret of the API audience (client credentials, for partners).
API_CLIENT_SECRET=__GENERATE__
# Shared password of the four synthetic test users (see README).
TEST_USER_PASSWORD=__GENERATE__

# --- Record Store (S3-compatible object storage) ----------------------------
RECORD_STORE_S3_PORT=7600
RECORD_STORE_ROOT_ACCESS_KEY=__GENERATE__
RECORD_STORE_ROOT_SECRET_KEY=__GENERATE__
RECORD_STORE_CREDENTIAL_MASTER_KEY=__GENERATE__
RECORD_STORE_MANAGEMENT_SYSTEM_TOKEN=__GENERATE__
S3_REGION=us-east-1
S3_BUCKET=field-photos

# --- Applications -----------------------------------------------------------
BACKEND_PORT=8080
PORTAL_PORT=3000
CONSOLE_PORT=3001
MARTIN_PORT=3002
CONSOLE_SESSION_SECRET=__GENERATE__
